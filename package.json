{
  "name": "expo-57-production-template",
  "version": "1.0.0",
  "description": "A reusable, production-oriented React Native template built with Expo SDK 57.",
  "private": true,
  "author": "Burak Kanber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datkanber/expo-57-production-template.git"
  },
  "bugs": {
    "url": "https://github.com/datkanber/expo-57-production-template/issues"
  },
  "homepage": "https://github.com/datkanber/expo-57-production-template#readme",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "i18next": "^26.3.6",
    "matter-js": "^0.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/matter-js": "^0.20.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "^1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "prettier": "^3.6.2",
    "test-renderer": "^1.0.0",
    "typescript": "~5.9.2"
  }
}
